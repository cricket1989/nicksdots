# Sample .vimrc
# Add your own customizations

" Enable syntax highlighting
syntax on

" Show line numbers
set number

" Enable mouse support
set mouse=a

" Set tab width
set tabstop=4
set shiftwidth=4
set expandtab

" Enable auto-indenting
set autoindent
set smartindent

" Search settings
set incsearch
set hlsearch
set ignorecase
set smartcase

" Enable file type detection
filetype plugin indent on

" Show matching brackets
set showmatch

" Add your custom configurations here
