#!/usr/bin/env bash
set -euo pipefail

CONF="$HOME/.config/ncmpcpp/tmux-music.conf"

if [[ -n "${TMUX:-}" ]]; then
  if tmux has-session -t music 2>/dev/null; then
    exec tmux switch-client -t music
  else
    exec tmux source-file "$CONF"
  fi
else
  if tmux has-session -t music 2>/dev/null; then
    exec tmux attach -t music
  else
    exec tmux source-file "$CONF"
  fi
fi
