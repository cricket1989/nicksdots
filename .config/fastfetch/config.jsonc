{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "~/.config/fastfetch/ascii.txt",
        "width": 40,
        "height": 21,
        "padding": {
            "top": 0,
            "left": 1,
            "bottom": 0
        }
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys": "36",
            "title": "36"
        }
    },

    "modules": [
        // line 1 — title: user@host
        {
            "type": "title",
            "keyColor": "36",
            "color": {
                "user": "96",
                "at": "37",
                "host": "96"
            }
        },
        // line 2 — separator
        {
            "type": "separator",
            "string": "─────────────────────────────"
        },
        // line 3
        {
            "type": "os",
            "key": "  os     ",
            "keyColor": "31",
            "valueColor": "39"
        },
        // line 4
        {
            "type": "host",
            "key": "  board  ",
            "keyColor": "31",
            "valueColor": "39"
        },
        // line 5
        {
            "type": "kernel",
            "key": "  kernel ",
            "keyColor": "32",
            "valueColor": "39"
        },
        // line 6
        {
            "type": "uptime",
            "key": "  uptime ",
            "keyColor": "32",
            "valueColor": "39"
        },
        // line 7
        {
            "type": "shell",
            "key": "  shell  ",
            "keyColor": "33",
            "valueColor": "39"
        },
        // line 8
        {
            "type": "terminal",
            "key": "  term   ",
            "keyColor": "33",
            "valueColor": "39"
        },
        // line 9
        {
            "type": "wm",
            "key": "  wm     ",
            "keyColor": "34",
            "valueColor": "39"
        },
        // line 10
        {
            "type": "wmtheme",
            "key": "󰉼  theme  ",
            "keyColor": "34",
            "valueColor": "39"
        },
        // line 11
        {
            "type": "icons",
            "key": "  icons  ",
            "keyColor": "35",
            "valueColor": "39",
            "format": "{2}"
        },
        // line 12
        {
            "type": "cpu",
            "key": "  cpu    ",
            "keyColor": "35",
            "valueColor": "39",
            "showPeCoreCount": false,
            "temp": false
        },
        // line 13
        {
            "type": "gpu",
            "key": "󰊓  gpu    ",
            "keyColor": "35",
            "valueColor": "39",
            "detectionMethod": "pci"
        },
        // line 14
        {
            "type": "memory",
            "key": "  ram    ",
            "keyColor": "36",
            "valueColor": "39"
        },
        // line 15
        {
            "type": "disk",
            "key": "  disk   ",
            "keyColor": "36",
            "valueColor": "39",
            "folders": "/"
        },
        // line 17
        {
            "type": "packages",
            "key": "󰏖  pkgs   ",
            "keyColor": "33",
            "valueColor": "39"
        },
        // line 18
        {
            "type": "localip",
            "key": "  net    ",
            "keyColor": "34",
            "valueColor": "39",
            "showIpv4": true,
            "showIpv6": false
        },
        // line 19
        {
            "type": "datetime",
            "format": "{5} {4}, {1}",
            "key": "  date   ",
            "keyColor": "35",
            "valueColor": "39"
        },
        // line 20 — blank spacer
        "break",
        // line 21 — color palette
        {
            "type": "colors",
            "paddingLeft": 1,
            "symbol": "circle"
        }
    ]
}
