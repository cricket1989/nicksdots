/**
 * Matugen Grid App Launcher
 * Dynamic Material You colors via matugen
 * Falls back to nord-grid if this file doesn't exist yet.
 *
 * Usage: rofi -show drun -theme ~/.local/share/rofi/themes/matugen-grid/style.rasi
 */

/* ── Colors (injected by matugen) ───────────────────────── */
* {
    bg:       {{colors.surface.default.hex}};
    bg-card:  {{colors.surface_variant.default.hex}};
    bg-input: {{colors.surface_container.default.hex}};
    fg:       {{colors.on_surface.default.hex}};
    fg-muted: {{colors.on_surface_variant.default.hex}};
    accent:   {{colors.primary.default.hex}};
    accent-fg: {{colors.on_primary.default.hex}};
    border-c: {{colors.outline_variant.default.hex}};
    sel-bg:   {{colors.primary_container.default.hex}};
    sel-fg:   {{colors.on_primary_container.default.hex}};
    urgent:   {{colors.error.default.hex}};

    font:               "JetBrainsMono Nerd Font 10";
    background-color:   transparent;
    text-color:         @fg;
    cursor:             "default";
    border:             0px;
    margin:             0px;
    padding:            0px;
    spacing:            0px;
}

/* ── Window ─────────────────────────────────────── */
window {
    background-color:   @bg;
    border:             2px solid;
    border-color:       @accent;
    border-radius:      18px;
    width:              980px;
    height:             680px;
    location:           center;
    transparency:       "real";
    x-offset:           0px;
    y-offset:           0px;
}

/* ── Configuration (embedded) ───────────────────── */
configuration {
    modi:                   "drun";
    show-icons:             true;
    icon-theme:             "Papirus";
    drun-display-format:    "{name}";
    hide-scrollbar:         true;
    display-drun:           " Apps";
    font:                   "JetBrainsMono Nerd Font 10";
}

/* ── Mainbox ─────────────────────────────────────── */
mainbox {
    background-color:   transparent;
    padding:            24px;
    spacing:            0px;
    children:           [inputbar, message, listview];
}

/* ── Search bar ──────────────────────────────────── */
inputbar {
    background-color:   @bg-input;
    border-radius:      12px;
    padding:            12px 18px;
    spacing:            10px;
    margin:             0px 0px 20px 0px;
    children:           [icon-search, entry, num-filtered-rows, textbox-num-sep, num-rows];
    border:             1px solid;
    border-color:       @border-c;
}

icon-search {
    expand:             false;
    filename:           "search";
    size:               18px;
    vertical-align:     0.5;
    background-color:   transparent;
    text-color:         @accent;
}

entry {
    background-color:   transparent;
    text-color:         @fg;
    placeholder:        "Search applications…";
    placeholder-color:  @fg-muted;
    cursor:             text;
    vertical-align:     0.5;
    expand:             true;
}

num-filtered-rows {
    expand:             false;
    background-color:   transparent;
    text-color:         @fg-muted;
    font:               "JetBrainsMono Nerd Font 9";
    vertical-align:     0.5;
}

textbox-num-sep {
    expand:             false;
    str:                "/";
    background-color:   transparent;
    text-color:         @fg-muted;
    vertical-align:     0.5;
    font:               "JetBrainsMono Nerd Font 9";
}

num-rows {
    expand:             false;
    background-color:   transparent;
    text-color:         @fg-muted;
    font:               "JetBrainsMono Nerd Font 9";
    vertical-align:     0.5;
}

/* ── Message (no results) ─────────────────────────── */
message {
    background-color:   transparent;
    margin:             0px 0px 8px 0px;
}

textbox {
    background-color:   @bg-card;
    text-color:         @fg;
    border-radius:      8px;
    padding:            8px 16px;
    horizontal-align:   0.5;
}

/* ── Grid list ───────────────────────────────────── */
listview {
    background-color:   transparent;
    spacing:            12px;
    columns:            5;
    lines:              3;
    fixed-columns:      true;
    fixed-height:       false;
    flow:               horizontal;
    scrollbar:          false;
    cycle:              true;
    dynamic:            true;
}

/* ── Grid card ───────────────────────────────────── */
element {
    background-color:   @bg-card;
    border-radius:      14px;
    padding:            18px 8px 14px 8px;
    orientation:        vertical;
    cursor:             pointer;
    border:             1px solid;
    border-color:       @border-c;
}

element normal.normal {
    background-color:   @bg-card;
    text-color:         @fg;
    border-color:       @border-c;
}

element normal.urgent {
    background-color:   @bg-card;
    text-color:         @urgent;
    border-color:       @urgent;
}

element normal.active {
    background-color:   @sel-bg;
    text-color:         @sel-fg;
    border-color:       @accent;
}

element selected.normal {
    background-color:   @sel-bg;
    text-color:         @sel-fg;
    border-color:       @accent;
    border:             1px solid;
}

element selected.urgent {
    background-color:   @urgent;
    text-color:         @bg;
    border-color:       @urgent;
}

element selected.active {
    background-color:   @accent;
    text-color:         @accent-fg;
    border-color:       @accent;
}

element alternate.normal {
    background-color:   @bg-card;
    text-color:         @fg;
    border-color:       @border-c;
}

element alternate.selected {
    background-color:   @sel-bg;
    text-color:         @sel-fg;
    border-color:       @accent;
    border:             1px solid;
}

/* ── Icon ─────────────────────────────────────────── */
element-icon {
    background-color:   transparent;
    size:               64px;
    horizontal-align:   0.5;
    vertical-align:     0.5;
    cursor:             inherit;
    margin:             0px 0px 10px 0px;
}

/* ── Label ─────────────────────────────────────────── */
element-text {
    background-color:   transparent;
    text-color:         inherit;
    horizontal-align:   0.5;
    vertical-align:     0.5;
    cursor:             inherit;
    font:               "JetBrainsMono Nerd Font 9";
    expand:             true;
}

/* ── Scrollbar ───────────────────────────────────── */
scrollbar {
    width:              4px;
    border:             0px;
    handle-color:       @accent;
    handle-width:       4px;
    padding:            0px;
    background-color:   @bg-card;
}
