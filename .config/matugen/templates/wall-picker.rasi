/**
 * Wall Picker — Matugen Dynamic
 * Autogenerated by matugen — do not edit
 * nick@cachyos
 */

* {
    bg:        {{colors.surface.default.hex}};
    bg-card:   {{colors.surface_container.default.hex}};
    bg-input:  {{colors.surface_container_high.default.hex}};
    fg:        {{colors.on_surface.default.hex}};
    fg-dim:    {{colors.on_surface_variant.default.hex}};
    accent:    {{colors.primary.default.hex}};
    sel-bg:    {{colors.primary_container.default.hex}};
    sel-fg:    {{colors.on_primary_container.default.hex}};
    border-c:  {{colors.outline_variant.default.hex}};

    font:               "JetBrainsMono Nerd Font 10";
    background-color:   transparent;
    text-color:         @fg;
    cursor:             default;
    border:             0px;
    margin:             0px;
    padding:            0px;
    spacing:            0px;
}

configuration {
    show-icons:  true;
    icon-theme:  "Papirus-Dark";
    font:        "JetBrainsMono Nerd Font 10";
}

window {
    background-color: @bg;
    border:           2px solid;
    border-color:     @accent;
    border-radius:    20px;
    width:            1200px;
    height:           720px;
    location:         center;
    x-offset:         0px;
    y-offset:         0px;
}

mainbox {
    background-color: transparent;
    padding:          24px;
    spacing:          16px;
    children:         [inputbar, listview];
}

inputbar {
    background-color: @bg-input;
    border-radius:    12px;
    padding:          12px 18px;
    spacing:          10px;
    margin:           0px 0px 4px 0px;
    children:         [prompt, entry, num-filtered-rows, textbox-num-sep, num-rows];
    border:           1px solid;
    border-color:     @border-c;
}

prompt {
    background-color: transparent;
    text-color:       @accent;
    vertical-align:   0.5;
    expand:           false;
}

entry {
    background-color: transparent;
    text-color:       @fg;
    placeholder:      "Search wallpapers…";
    placeholder-color: @fg-dim;
    cursor:           text;
    vertical-align:   0.5;
    expand:           true;
}

num-filtered-rows, num-rows {
    expand:           false;
    background-color: transparent;
    text-color:       @fg-dim;
    font:             "JetBrainsMono Nerd Font 9";
    vertical-align:   0.5;
}

textbox-num-sep {
    expand:           false;
    str:              "/";
    background-color: transparent;
    text-color:       @fg-dim;
    vertical-align:   0.5;
    font:             "JetBrainsMono Nerd Font 9";
}

listview {
    background-color: transparent;
    spacing:          12px;
    columns:          4;
    lines:            3;
    fixed-columns:    true;
    fixed-height:     false;
    flow:             horizontal;
    scrollbar:        false;
    cycle:            true;
    dynamic:          true;
}

element {
    background-color: @bg-card;
    border-radius:    14px;
    padding:          10px 8px 8px 8px;
    orientation:      vertical;
    cursor:           pointer;
    border:           2px solid;
    border-color:     transparent;
}

element normal.normal  { background-color: @bg-card;  border-color: transparent; }
element selected.normal { background-color: @sel-bg; text-color: @sel-fg; border-color: @accent; border: 2px solid; }
element alternate.normal { background-color: @bg-card; border-color: transparent; }

element:hover { border-color: @border-c; }

element-icon {
    background-color: transparent;
    size:             160px;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    cursor:           default;
    margin:           0px 0px 8px 0px;
    border-radius:    10px;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    cursor:           default;
    font:             "JetBrainsMono Nerd Font 8";
    expand:           false;
}

scrollbar {
    width:            4px;
    border:           0px;
    handle-color:     @accent;
    handle-width:     4px;
    background-color: @bg-card;
}
