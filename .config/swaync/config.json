{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "cssPriority": "user",

  "positionX": "right",
  "positionY": "top",

  "control-center-width": 430,
  "control-center-height": 900,

  "control-center-margin-top": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 10,
  "control-center-margin-left": 0,

  "notification-window-width": 400,
  "notification-icon-size": 48,
  "notification-body-image-height": 0,
  "notification-body-image-width": 0,

  "timeout": 4,
  "timeout-low": 2,
  "timeout-critical": 6,

  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": false,
  "script-fail-notify": true,

  "widgets": [
    "mpris",
    "buttons-grid",
    "volume",
    "dnd",
    "title",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "󰎟  Clear"
    },

    "dnd": {
      "text": "Do not Disturb"
    },

    "volume": {
      "label": "󰕾",
      "show-per-app": false
    },

    "mpris": {
      "image-size": 96,
      "image-radius": 12,
      "show-album-art": "playing",
      "blacklist": ["firefox", "zen", "brave", "mpv", "chromium"],
      "autohide": true,
      "prefer": ["spotify", "spotatui"]
    },

    "buttons-grid": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "󰝚",
          "tooltip": "Mute / Unmute",
          "command": "bash -lc 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'",
          "type": "toggle"
        },
        {
          "label": "󰤨",
          "tooltip": "Wi-Fi",
          "command": "bash -lc 'nmcli radio wifi toggle'",
          "type": "toggle"
        },
        {
          "label": "󰂯",
          "tooltip": "Bluetooth",
          "command": "bash -lc 'bluetoothctl power toggle'",
          "type": "toggle"
        },
        {
          "label": "󰹑",
          "tooltip": "Screenshot (region)",
          "command": "swaync-client -t -sw; bash $HOME/.config/waybar/scripts/screenshot.sh region"
        },
        {
          "label": "󰸉",
          "tooltip": "Wallpaper",
          "command": "swaync-client -t -sw; waypaper"
        },
        {
          "label": "󰏘",
          "tooltip": "Matugen color picker",
          "command": "bash -lc '$HOME/.local/bin/matugen-rofi-pick.sh'"
        },
        {
          "label": "󰖔",
          "tooltip": "Night mode",
          "command": "bash -lc \"$HOME/.config/hypr/scripts/nightmode.sh\"",
          "type": "toggle"
        },
        {
          "label": "",
          "tooltip": "Power menu",
          "command": "swaync-client -t -sw; bash $HOME/.config/waybar/scripts/wlogout-power.sh"
        }
      ]
    }
  }
}
