// ─────────────────────────────────────────────────────────────
//  origincode layout — adapted from OriginCode/dotfiles
//  Minimal floating modules, gruvbox dark, cava visualizer.
//  Hyprland port: sway/* → hyprland/*, wireplumber → pulseaudio
//  Single bar — all monitors
// ─────────────────────────────────────────────────────────────
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,
  "exclusive": true,
  "passthrough": false,

  "modules-left": [
    "custom/os_button",
    "hyprland/workspaces",
    "cava",
    "hyprland/submap"
  ],

  "modules-center": [
    "hyprland/window"
  ],

  "modules-right": [
    "mpris",
    "idle_inhibitor",
    "group/sysinfo",
    "clock",
    "tray",
    "custom/power"
  ],

  // ── Workspaces ────────────────────────────────────────────
  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "format": "{icon}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1",
    "persistent-workspaces": {
      "DP-2": [1],
      "DP-3": [2, 3, 4, 5, 6, 7, 8],
      "DP-1": [9]
    },
    "format-icons": {
      "1": "\uDB80\uDD8D",
      "2": "\uDB80\uDE39",
      "3": "\uDB82\uDE1E",
      "4": "\uDB80\uDEE9",
      "5": "\uDB80\uDEA0",
      "6": "\uDB80\uDF84",
      "7": "\uDB84\uDF93",
      "8": "\uDB81\uDE6F",
      "9": "\uDB82\uDF79",
      "urgent": "\uDB80\uDC26",
      "default": "\uDB82\uDFAF",
      "active": "\uDB82\uDFAF"
    }
  },

  // ── Cava ──────────────────────────────────────────────────
  "cava": {
    "framerate": 30,
    "autosens": 1,
    "bars": 12,
    "lower_cutoff_freq": 50,
    "higher_cutoff_freq": 10000,
    "method": "pipewire",
    "source": "auto",
    "stereo": false,
    "bar_delimiter": 0,
    "noise_reduction": 0.77,
    "input_delay": 2,
    "hide_on_silence": true,
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "actions": {
      "on-click-right": "mode"
    }
  },

  // ── Window title ───────────────────────────────────────────
  "hyprland/window": {
    "format": "{title}",
    "max-length": 50,
    "rewrite": {
      "(.*) — Mozilla Firefox": "󰈹 $1",
      "(.*) - kitty": "󰄛 $1",
      "(.*) - nvim": "󰈮 $1",
      ".*": "{}"
    }
  },

  // ── Submap ─────────────────────────────────────────────────
  "hyprland/submap": {
    "format": "{}",
    "max-length": 20
  },

  // ── MPRIS (media player) ───────────────────────────────────
  "mpris": {
    "format": "{status_icon} {dynamic}",
    "interval": 1,
    "dynamic-len": 36,
    "status-icons": {
      "playing": "▶",
      "paused": "⏸",
      "stopped": ""
    },
    "dynamic-order": ["title", "artist"],
    "ignored-players": ["firefox", "chromium"]
  },

  // ── Idle inhibitor ─────────────────────────────────────────
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾫"
    },
    "tooltip-format-activated": "Idle inhibitor: ON",
    "tooltip-format-deactivated": "Idle inhibitor: OFF"
  },

  // ── Sysinfo collapsible group ──────────────────────────────
  "group/sysinfo": {
    "orientation": "inherit",
    "modules": ["custom/sysinfo-btn", "pulseaudio", "custom/sysinfo-cpu", "custom/sysinfo-mem", "custom/sysinfo-temp"]
  },

  "custom/sysinfo-btn": {
    "format": "󰈸",
    "tooltip-format": "Toggle CPU / RAM / Temp",
    "on-click": "~/.config/waybar-clean/scripts/sysinfo-toggle.sh",
    "interval": "once",
    "signal": 10
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰸈",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
    "tooltip-format": "{desc} — {volume}%"
  },

  "custom/sysinfo-cpu": {
    "exec": "~/.config/waybar-clean/scripts/sysinfo-cpu.sh",
    "return-type": "json",
    "interval": 3,
    "signal": 10,
    "tooltip": true
  },

  "custom/sysinfo-mem": {
    "exec": "~/.config/waybar-clean/scripts/sysinfo-mem.sh",
    "return-type": "json",
    "interval": 5,
    "signal": 10,
    "tooltip": true
  },

  "custom/sysinfo-temp": {
    "exec": "~/.config/waybar-clean/scripts/sysinfo-temp.sh",
    "return-type": "json",
    "interval": 5,
    "signal": 10,
    "tooltip": true
  },

  // ── Clock ──────────────────────────────────────────────────
  "clock": {
    "format": "󰅐 {:%H:%M}",
    "format-alt": "{:%a %b %d}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  // ── Tray ───────────────────────────────────────────────────
  "tray": {
    "icon-size": 14,
    "spacing": 6
  },

  // ── Power ──────────────────────────────────────────────────
  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Power menu",
    "on-click": "~/.config/waybar-clean/scripts/wlogout-power.sh",
    "interval": "once"
  },

  "custom/os_button": {
    "format": "  ",
    "on-click": "pkill rofi || $HOME/.local/share/rofi/scripts/nord-grid-launcher.sh",
    "tooltip": false
  }
}
