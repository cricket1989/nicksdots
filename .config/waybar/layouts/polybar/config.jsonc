{
  "layer": "top",
  "position": "top",
  "height": 36,
  "margin-top": 10,
  "margin-left": 14,
  "margin-right": 14,

  "modules-left": [
    "custom/launcher",
    "custom/sep1",
    "hyprland/workspaces",
    "custom/sep2",
    "network"
  ],

  "modules-center": [
    "custom/mpd"
  ],

  "modules-right": [
    "cpu",
    "custom/sep3",
    "memory",
    "custom/sep4",
    "pulseaudio",
    "custom/sep5",
    "battery",
    "custom/sep6",
    "tray",
    "clock",
    "custom/screenshot",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "",
    "on-click": "rofi -show drun",
    "tooltip": false
  },

  "custom/sep1": { "format": "", "tooltip": false },
  "custom/sep2": { "format": "", "tooltip": false },
  "custom/sep3": { "format": "", "tooltip": false },
  "custom/sep4": { "format": "", "tooltip": false },
  "custom/sep5": { "format": "", "tooltip": false },
  "custom/sep6": { "format": "", "tooltip": false },

  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "format": "{icon}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1",
    "persistent-workspaces": {
      "DP-2": [1],
      "DP-3": [2, 3, 4, 5, 6, 7, 8],
      "DP-1": [9]
    },
    "format-icons": {
      "1": "\udb80\udc4d",
      "2": "\udb80\udeb9",
      "3": "\udb82\ude1e",
      "4": "\udb80\udee9",
      "5": "\udb80\udea0",
      "6": "\udb80\udf84",
      "7": "\udb84\udf93",
      "8": "\udb82\udf79",
      "9": "\udb82\udf79",
      "urgent": "\udb80\udc26",
      "default": "\udb82\udfaf",
      "active": "\udb82\udfaf"
    }
  },

  "network": {
    "interface": "wlan0",
    "format-wifi": "{icon}",
    "format-disconnected": "󰖪  Offline",
    "interval": 5
  },

  "cpu": { "format": "  {usage}%", "interval": 5 },
  "memory": { "format": "󰍛  {used:0.1f}G", "interval": 5 },

  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "󰖁  Muted",
    "on-click": "pavucontrol",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
  },

  "battery": { "format": "{capacity}% " },

  "tray": { "spacing": 8 },

  "clock": { "format": "  {:%a %d %b  %I:%M %p}" },

  "custom/mpd": {
    "exec": "~/.local/bin/waybar-mpd.sh",
    "return-type": "json",
    "interval": 1,
    "on-click": "mpc toggle",
    "on-click-right": "kitty -e ncmpcpp"
  },

  // ── Screenshot ──────────────────────────────────────
  "custom/screenshot": {
    "format": "󰹑",
    "tooltip-format": "Screenshot\nLeft: Region  Right: Fullscreen  Mid: Window",
    "on-click": "~/.config/waybar-clean/scripts/screenshot.sh region",
    "on-click-right": "~/.config/waybar-clean/scripts/screenshot.sh full",
    "on-click-middle": "~/.config/waybar-clean/scripts/screenshot.sh window",
    "interval": "once"
  },

  // ── Power menu ───────────────────────────────────────
  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Power menu",
    "on-click": "~/.config/waybar-clean/scripts/wlogout-power.sh",
    "interval": "once"
  }
}
