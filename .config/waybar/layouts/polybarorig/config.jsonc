{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,

  "modules-left": ["custom/launcher", "hyprland/workspaces"],
  "modules-center": ["mpd"],
  "modules-right": ["network", "cpu", "memory", "pulseaudio", "battery", "clock"],

  "custom/launcher": {
    "format": "󰣇",
    "on-click": "rofi -show drun",
    "tooltip": false
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "persistent-workspaces": {
      "*": 5
    }
  },

  "network": {
    "interface": "wlan0",
    "format-wifi": "  {essid}",
    "format-disconnected": "󰖪  Offline",
    "interval": 5
  },

  "cpu": {
    "format": "  {usage}%",
    "interval": 5
  },

  "memory": {
    "format": "󰍛  {used:0.1f}G",
    "interval": 5
  },

  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "󰖁  Muted",
    "on-click": "pavucontrol",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
  },

  "battery": {
    "format": "{capacity}% "
  },

  "clock": {
    "format": "  {:%a, %d %b %I:%M %p}"
  },

  "mpd": {
    "format": "  {artist} - {title}",
    "format-paused": "  {artist} - {title}",
    "format-stopped": "  MPD",
    "format-disconnected": "󰝛  MPD off",
    "max-length": 50,
    "on-click": "mpc toggle",
    "on-click-right": "kitty -e ncmpcpp",
    "on-scroll-up": "mpc volume +5",
    "on-scroll-down": "mpc volume -5",
    "tooltip": true
  }
}
