{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 0,

  "modules-left": [
    "custom/launcher",
    "custom/sep_a_b_r",
    "hyprland/workspaces"
  ],

  "modules-center": [
    "custom/mpd"
  ],

  "modules-right": [
    "custom/sep_b_c_r",
    "tray",
    "custom/sep_b_c_r",

    "pulseaudio",
    "custom/sep_c_d_r",

    "custom/bluetooth",
    "custom/sep_d_b_r",

    "custom/wttr",
    "custom/sep_d_b_r",

    "network",
    "custom/sep_d_b_r",

    "cpu",
    "custom/sep_b_a_r",

    "memory",
    "idle_inhibitor",
    "custom/screenshot",
    "custom/power"
  ],

  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "format": "{icon}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1",
    "persistent-workspaces": {
      "DP-2": [1],
      "DP-3": [2, 3, 4, 5, 6, 7, 8],
      "DP-1": [9]
    },
    "format-icons": {
      "1": "\udb80\udc4d",
      "2": "\udb80\udeb9",
      "3": "\udb82\ude1e",
      "4": "\udb80\udee9",
      "5": "\udb80\udea0",
      "6": "\udb80\udf84",
      "7": "\udb84\udf93",
      "8": "\udb82\udf79",
      "9": "\udb82\udf79",
      "urgent": "\udb80\udc26",
      "default": "\udb82\udfaf",
      "active": "\udb82\udfaf"
    }
  },

  "tray": {
    "spacing": 8
  },

  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "  muted",
    "on-click": "pavucontrol"
  },

  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀  {ipaddr}",
    "format-disconnected": "󰤮  down",
    "tooltip": true
  },

  "cpu": {
    "format": "  {usage}%",
    "tooltip": true
  },

  "memory": {
    "format": "  {percentage}%",
    "tooltip": true
  },

  "custom/launcher": {
    "format": "",
    "tooltip": false,
    "on-click": "$HOME/.config/rofi/scripts/launcher_t1"
  },

  "custom/mpd": {
    "exec": "~/.config/waybar/scripts/mpd.sh",
    "return-type": "json",
    "interval": 2,
    "tooltip": true
  },

  "custom/wttr": {
    "exec": "~/.config/waybar/scripts/wttr.sh",
    "return-type": "json",
    "interval": 600,
    "tooltip": true,
    "on-click": "xdg-open 'https://wttr.in'"
  },

  "custom/bluetooth": {
    "exec": "~/.config/waybar/scripts/bluetooth.sh",
    "return-type": "json",
    "interval": 5,
    "tooltip": true,
    "on-click": "blueman-manager"
  },

  "custom/sep_a_b_r": { "format": "", "tooltip": false },
  "custom/sep_b_c_r": { "format": "", "tooltip": false },
  "custom/sep_c_d_r": { "format": "", "tooltip": false },
  "custom/sep_d_b_r": { "format": "", "tooltip": false },
  "custom/sep_b_a_r": { "format": "", "tooltip": false },

  // ── Idle inhibitor ──────────────────────────────────
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾫"
    },
    "tooltip-format-activated": "Idle inhibitor: ON",
    "tooltip-format-deactivated": "Idle inhibitor: OFF"
  },

  // ── Screenshot ──────────────────────────────────────
  "custom/screenshot": {
    "format": "󰹑",
    "tooltip-format": "Screenshot\nLeft: Region  Right: Fullscreen  Mid: Window",
    "on-click": "~/.config/waybar-clean/scripts/screenshot.sh region",
    "on-click-right": "~/.config/waybar-clean/scripts/screenshot.sh full",
    "on-click-middle": "~/.config/waybar-clean/scripts/screenshot.sh window",
    "interval": "once"
  },

  // ── Power menu ───────────────────────────────────────
  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Power menu",
    "on-click": "~/.config/waybar-clean/scripts/wlogout-power.sh",
    "interval": "once"
  }
}