{
  "layer": "top",
  "position": "top",
  "margin-top": 4,

"modules-left": [
  "custom/os_button",
  "custom/media"
],

"modules-center": [
  "custom/notification",
  "hyprland/workspaces",
  "custom/hypridle"
],

"modules-right": [
  "tray",
  "pulseaudio",
  "network",
  "custom/weather",
  "cpu",
  "custom/pacman",
  "clock"
]

  "custom/os_button": {
    "format": "( ⼹ )",
    "on-click": "pkill rofi || /home/nick/.local/share/rofi/scripts/LauncherN1.sh",
    "tooltip": false
  },

  "clock": {
    "format": "┋ {:%R %d.%m.%Y} ┋",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#ffd866'><b>{}</b></span>",
        "days": "<span color='#f92672'><b>{}</b></span>",
        "weeks": "<span color='#66d9ef'><b>W{}</b></span>",
        "weekdays": "<span color='#a6e22e'><b>{}</b></span>",
        "today": "<span color='#ae81ff'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
      "on-click": "shift_up"
    }
  },

  "custom/weather": {
    "format": "┇ {}° ┇",
    "tooltip": true,
    "interval": 3600,
    "exec": "wttrbar --location Rochester_Hills --fahrenheit --main-indicator FeelsLikeF",
    "return-type": "json",
    "on-click": "kitty --title monokai-weather -e sh -lc 'curl -s wttr.in/Rochester_Hills?0 | less -R'",
    "on-click-right": "pkill -SIGRTMIN+8 waybar || pkill -RTMIN+8 waybar",
    "on-click-middle": "xdg-open 'https://wttr.in/Rochester_Hills'",
    "tooltip-format": "Left: forecast popup\nMiddle: browser forecast\nRight: refresh module"
  },

  "custom/mpd": {
    "format": "(  🯸🯶🯸{icon} )",
    "return-type": "json",
    "interval": 2,
    "exec": "~/.config/waybar/scripts/mpd-status.sh",
    "on-click": "~/.config/waybar/scripts/mpd-toggle.sh",
    "on-click-right": "mpc -q toggle",
    "on-click-middle": "kitty --title mpd-now -e sh -lc 'mpc status; echo; read -n 1 -rsp \"Press any key to close...\"'",
    "on-scroll-up": "mpc -q next",
    "on-scroll-down": "mpc -q prev",
    "tooltip": true
  },

  "custom/media": {
    "return-type": "json",
    "interval": 1,
    "exec": "~/.config/waybar/scripts/media.sh",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip": true
  },

  "custom/notification": {
    "tooltip": true,
    "tooltip-format": "Left: notification script\nMiddle: panel\nRight: Do Not Disturb",
    "format": "(⼑ {})",
    "format-icons": {
      "notification": "<span foreground='#f92672'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='#f92672'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='#f92672'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='#f92672'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "/home/nick/.local/bin/notifications-toggle.sh",
    "on-click-middle": "sleep 0.1 && swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "all-outputs": false,
    "disable-scroll": false,
    "persistent-workspaces": {
      "DP-2": [1],
      "DP-3": [2, 3, 4],
      "DP-1": [9]
    },
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "󰙯",
      "6": "󰎄",
      "7": "󰋩",
      "8": "󰊠",
      "9": "󰭹",
      "urgent": "",
      "default": "󰮯"
    },
    "on-click": "activate",
    "on-scroll-down": "hyprctl dispatch workspace e+1",
    "on-scroll-up": "hyprctl dispatch workspace e-1"
  },

  "custom/hypridle": {
    "format": "(🡅{} )",
    "return-type": "json",
    "interval": 2,
    "exec": "bash ~/.config/waybar/scripts/hypridle-status.sh",
    "on-click": "bash ~/.config/waybar/scripts/hypridle-toggle.sh",
    "on-click-right": "kitty --title hypridle-status -e systemctl --user status hypridle --no-pager -l",
    "tooltip": true
  },

  "custom/pacman": {
    "format": "(🡇 {})",
    "interval": 900,
    "exec": "bash -lc 'checkupdates 2>/dev/null | wc -l || echo 0'",
    "on-click": "/home/nick/.local/bin/update-system",
    "on-click-right": "kitty --title pacman-updates -e bash -lc 'checkupdates 2>/dev/null || true; echo; read -n 1 -rsp \"Press any key to close...\"'",
    "tooltip-format": "{} updates available"
  },

  "cpu": {
    "format": "(ᚸ {usage}% )",
    "interval": 2,
    "tooltip": true,
    "on-click": "kitty --title btop -e btop"
  },

  "pulseaudio": {
    "format": "({icon}  {volume}%)",
    "format-bluetooth": "(󰂱  {volume}%)",
    "format-muted": "(󰖁 mute)",
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-middle": "kitty --title audio-status -e sh -lc 'wpctl status; echo; read -n 1 -rsp \"Press any key to close...\"'",
    "ignored-sinks": ["Easy Effects Sink"],
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["󰖀", "󰕾"]
    },
    "tooltip-format": "Volume: {volume}%"
  },

  "network": {
    "interface": "wlan0",
    "format-wifi": "┋ {icon} {essid} ({signalStrength}%) ┋",
    "format-ethernet": "┋  {ipaddr} ┋",
    "format-linked": "┋ 󰈀 {ifname} ┋",
    "format-disconnected": "┋ 󰌙 offline ┋",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "SSID: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}\nGateway: {gwaddr}",
    "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
    "tooltip-format-disconnected": "No network connection",
    "on-click": "kitty --title nmtui -e nmtui",
    "on-click-right": "nm-connection-editor",
    "on-click-middle": "nmcli device wifi rescan"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 4
  }
}