{
  "height": 32,
  "spacing": 2,
  "layer": "top",

  "modules-left": [
    "custom/launcher",
    "clock",
    "custom/weather",
    "hyprland/workspaces"
  ],

  "modules-center": [
    "custom/notification",
    "custom/media"
  ],

  "modules-right": [
    "custom/pacman",
    "pulseaudio",
    "battery",
    "network",
    "power-profiles-daemon",
    "custom/screenshot",
    "custom/power"
  ],
  
  "custom/launcher": {
    "format": "󰣇",
    "on-click": "rofi -show drun"
  },

"custom/weather": {
  "exec": "~/.config/waybar/scripts/weather-openmeteo.sh",
  "return-type": "json",
"format": "{}",
  "format-icons": {
    "sunny": "󰖙",
    "cloudy": "󰖐",
    "rainy": "󰖗",
    "snowy": "󰖘",
    "foggy": "󰖑",
    "thunder": "󰙾"
  },
  "tooltip": true,
  "interval": 600
},

  "clock": {
    "format": "{:%I:%M %p}",
    "format-alt": "{:%a, %d. %b}"
  },

  "sway/window": {
    "max-length": 50
  },

  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "format": "{icon}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1",
    "persistent-workspaces": {
      "DP-2": [1],
      "DP-3": [2, 3, 4, 5, 6, 7, 8],
      "DP-1": [9]
    },
    "format-icons": {
      "1": "\udb80\udc4d",
      "2": "\udb80\udeb9",
      "3": "\udb82\ude1e",
      "4": "\udb80\udee9",
      "5": "\udb80\udea0",
      "6": "\udb80\udf84",
      "7": "\udb84\udf93",
      "8": "\udb82\udf79",
      "9": "\udb82\udf79",
      "urgent": "\udb80\udc26",
      "default": "\udb82\udfaf",
      "active": "\udb82\udfaf"
    }
  },

"power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "󰗑",
      "power-saver": "󰌪"
    }
  },
  
"battery": {
    "format": "{capacity}% {icon}",
    "format-icons": ["", "", "", "", ""],
    "max-length": 25
  },

  "custom/notification": {
    "tooltip": true,
    "format": "<span size='12pt'>{icon}</span>",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "custom/media": {
    "format": {
      "playing": "{artist} - {title} {icon}",
      "paused": "{artist} - {title} {icon}"
    },
      "escape": true,
      "return-type": "json",
      "max-length": 40,
      "on-click": "playerctl play-pause",
      "on-click-right": "playerctl stop",
      "smooth-scrolling-threshold": 10, // This value was tested using a trackpad, it should be lowered if using a mouse.
      "on-scroll-up": "playerctl next",
      "on-scroll-down": "playerctl previous",
      "exec": "$HOME/.config/waybar/scripts/mediaplayer.py 2> /dev/null" // Script in resources/custom_modules folder
  },

  "custom/pacman": {
      "format": "{} ",
      "interval": 3600,                     // every hour
      "exec": "checkupdates | wc -l",       // # of updates
      "exec-if": "exit 0",                  // always run; consider advanced run conditions
      "on-click": "~/.config/waybar/scripts/update.sh",
      "signal": 8
  },

    "pulseaudio": {
      "format": "{volume}% {icon}",
      "format-bluetooth": "{volume}% {icon}",
      "format-muted": "",
      "format-icons": {
          "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
          "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
          "headphone": "",
          "hands-free": "",
          "headset": "",
          "phone": "",
          "phone-muted": "",
          "portable": "",
          "car": "",
          "default": ["", ""]
      },
      "scroll-step": 1,
      "on-click": "pavucontrol",
      "ignored-sinks": ["Easy Effects Sink"]
  },

  "network": {
      "interface": "wlp4s0",
      "format": "{ifname}",
      "format-wifi": "{icon}",
      "format-ethernet": "{ipaddr}/{cidr} 󰊗",
      "format-disconnected": "", //An empty format will hide the module.
      "tooltip-format": "{ifname} via {gwaddr} 󰊗",
      "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
      "tooltip-format-ethernet": "{ifname} ",
      "tooltip-format-disconnected": "Disconnected",
      "max-length": 50
  },

  // ── Screenshot ──────────────────────────────────────
  "custom/screenshot": {
    "format": "󰹑",
    "tooltip-format": "Screenshot\nLeft: Region  Right: Fullscreen  Mid: Window",
    "on-click": "~/.config/waybar-clean/scripts/screenshot.sh region",
    "on-click-right": "~/.config/waybar-clean/scripts/screenshot.sh full",
    "on-click-middle": "~/.config/waybar-clean/scripts/screenshot.sh window",
    "interval": "once"
  },

  // ── Power menu ───────────────────────────────────────
  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Power menu",
    "on-click": "~/.config/waybar-clean/scripts/wlogout-power.sh",
    "interval": "once"
  }
}
