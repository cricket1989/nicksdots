{
  "layer": "top",
  "position": "top",
  "height": 24,
  "spacing": 4,
  "modules-left": [
    "wlr/workspaces",
    "wlr/taskbar"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "pulseaudio",
    "network",
    "tray",
    "clock",
    "custom/weather"
  ],
  "wlr/taskbar": {
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": [
      "kitty",
      "Alacritty",
      "org.wezfurlong.wezterm"
    ]
  },
  "wlr/workspaces": {
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },
  "hyprland/window": {
    "max-length": 128
  },
  "clock": {
    "format": " ( ͜.人 ͜. ） {:%c} ( ͜.人 ͜. ） ",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "cpu": {
    "format": " ( ͜.人 ͜. ） {usage}%",
    "on-click": "~/.config/waybar/scripts/popup-cpu.sh",
    "tooltip": false
  },
  "memory": {
    "format": " 凸( •̀_•́ )凸 {percentage}%",
    "on-click": "~/.config/waybar/scripts/popup-mem.sh",
    "tooltip": false
  },
  "network": {
    "format-wifi": " 凸( •̀_•́ )凸 {signalStrength}%",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-disconnected": "󰤭 down",
    "on-click": "~/.config/waybar/scripts/popup-net.sh",
    "tooltip": false
  },
  "pulseaudio": {
    "format": " ( ͜.人 ͜. ） {volume}%",
    "format-muted": "󰝟",
    "on-click": "~/.config/waybar/scripts/popup-audio.sh",
    "tooltip": false
  },

  "tray": {
    "spacing": 8
  },
  "custom/weather": { 
    "format": "{text}°",  
    "tooltip": true,  
    "interval": 3600, 
    "exec": "wttrbar --location \"Pontiac\" --fahrenheit --main-indicator FeelsLikeF",  
    "return-type": "json"
}
 
}
