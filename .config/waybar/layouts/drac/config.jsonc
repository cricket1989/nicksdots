{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 6,

  "modules-left": [
    "hyprland/workspaces",
    "wlr/taskbar"
  ],

  "modules-center": [
    "hyprland/window"
  ],

  "modules-right": [
    "idle_inhibitor",
    "mpris",
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "temperature",
    "tray",
    "hyprland/language",
    "custom/weather",
    "clock",
    "custom/powermenu"
  ],

  "wlr/taskbar": {
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": ["kitty", "Alacritty", "org.wezfurlong.wezterm"]
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "active": " 💀⃤ ",
      "default": " 𒆙 ",
      "urgent": " 卍 "
    },
    "persistent-workspaces": {
      "*": 5
    }
  },

  "hyprland/window": {
    "max-length": 96,
    "separate-outputs": true
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "🌕",
      "deactivated": "🌑",
    },
    "tooltip": true
  },

  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "{player_icon} 󰏤 {title}",
    "player-icons": {
      "default": "󰎆",
      "firefox": "󰈹",
      "spotify": "󰓇"
    },
    "status-icons": {
      "paused": "󰏤"
    },
    "max-length": 40,
    "tooltip": true
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "tooltip": true
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-icons": ["󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
    "tooltip": true
  },

  "network": {
    "format-wifi": "󰤨 {signalStrength}%",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-disconnected": "󰤭 down",
    "tooltip": true
  },

  "cpu": {
    "format": "󰍛 {usage}%",
    "tooltip": true
  },

  "memory": {
    "format": "󰘚 {percentage}%",
    "tooltip": true
  },

  "temperature": {
    "format": "󰔏 {temperatureC}°C",
    "tooltip": true
  },

  "tray": {
    "spacing": 6
  },

  "custom/weather": {
    "exec": "~/.config/waybar/wittr.sh",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "interval": 900
  },

  "clock": {
    "format": "󰥔 {:%a %b %d  %I:%M %p}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "custom/powermenu": {
    "format": "",
    "tooltip": "Power",
    "on-click": "wlogout"
  }
}
