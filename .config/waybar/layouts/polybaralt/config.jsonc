{
  "layer": "top",
  "position": "top",
  "height": 36,
  "margin-top": 10,
  "margin-left": 14,
  "margin-right": 14,

  "modules-left": ["custom/launcher", "custom/power_sep", "hyprland/workspaces"],
  "modules-center": ["mpd"],
  "modules-right": ["network", "custom/power_sep", "cpu", "memory", "custom/power_sep", "pulseaudio", "battery", "tray", "clock"],

  "custom/launcher": {
    "format": "󰣇",
    "on-click": "rofi -show drun",
    "tooltip": false
  },

  "custom/power_sep": {
    "format": "",
    "tooltip": false
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "persistent-workspaces": { "*": 5 }
  },

  "network": {
    "interface": "wlan0",
    "format-wifi": "  {essid}",
    "format-disconnected": "󰖪  Offline",
    "interval": 5
  },

  "cpu": {
    "format": "  {usage}%",
    "interval": 5
  },

  "memory": {
    "format": "󰍛  {used:0.1f}G",
    "interval": 5
  },

  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "󰖁  Muted",
    "on-click": "pavucontrol",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
  },

  "battery": {
    "format": "{capacity}% "
  },

  "tray": {
    "spacing": 8
  },

  "clock": {
    "format": "  {:%a, %d %b %I:%M %p}"
  },

  "mpd": {
    "format": "{stateIcon}  {artist} - {title}\n{elapsed}/{total}  {bar}",
    "format-disconnected": "󰝛  MPD off",
    "format-stopped": "  MPD",
    "format-paused": "  {artist} - {title}\n{elapsed}/{total}  {bar}",
    "format-playing": "  {artist} - {title}\n{elapsed}/{total}  {bar}",
    "state-icons": {
      "paused": "",
      "playing": "",
      "stopped": ""
    },
    "bar": {
      "width": 18,
      "indicator": "",
      "fill": "─",
      "empty": "─"
    },
    "max-length": 60,
    "on-click": "mpc toggle",
    "on-click-right": "kitty -e ncmpcpp",
    "on-scroll-up": "mpc volume +5",
    "on-scroll-down": "mpc volume -5",
    "tooltip": true
  }
}
