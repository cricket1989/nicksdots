{
  "layer": "top",
  "position": "top",
  "margin-top": 4,

  "modules-left": [
    "custom/os_button",
    "custom/media"
  ],

  "modules-center": [
    "custom/notification",
    "hyprland/workspaces",
    "custom/hypridle"
  ],

  "modules-right": [
    "tray",
    "pulseaudio",
    "network",
    "custom/weather",
    "custom/mpd",
    "cpu",
    "custom/pacman",
    "clock"
  ],

  "custom/os_button": {
    "format": "  APPS",
    "on-click": "pkill rofi || /home/nick/.local/share/rofi/scripts/LauncherN1.sh",
    "tooltip": false
  },

  "custom/media": {
    "return-type": "json",
    "interval": 1,
    "exec": "~/.config/waybar/scripts/media.sh",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip": true
  },

  "custom/notification": {
    "tooltip": false,
    "format": "( {icon} )",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "/home/nick/.local/bin/notifications-toggle.sh",
    "on-click-middle": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "format": "{icon}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1",
    "persistent-workspaces": {
      "DP-2": [1],
      "DP-3": [2, 3, 4],
      "DP-1": [9]
    },
    "format-icons": {
      "1": "󰆍",
      "2": "󰈹",
      "3": "󰨞",
      "4": "󰋩",
      "5": "󰊠",
      "6": "󰎄",
      "7": "󱎓",
      "8": "󰙯",
      "9": "󰭹",
      "urgent": "󰀦",
      "default": "󰮯"
    }
  },

  "custom/hypridle": {
    "format": "( {} )",
    "return-type": "json",
    "interval": 2,
    "exec": "bash ~/.config/waybar/scripts/hypridle-status.sh",
    "on-click": "bash ~/.config/waybar/scripts/hypridle-toggle.sh",
    "on-click-right": "kitty -e systemctl --user status hypridle --no-pager -l",
    "tooltip": true
  },

  "pulseaudio": {
    "format": "󰲑 {volume}%",
    "format-bluetooth": "󰂱 {volume}%",
    "format-muted": "󰖁",
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "ignored-sinks": ["Easy Effects Sink"],
    "format-icons": {
      "headphone": "𝄃𝄃𝄂𝄂",
      "hands-free": "",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["󰲑", "󰲑"]
    },
    "tooltip-format": "Volume: {volume}%"
  },

  "network": {
    "interface": "wlan0",
    "format-wifi": "{icon}  {essid}",
    "format-ethernet": "󰈀  {ipaddr}/{cidr}",
    "format-linked": "󰈀  {ifname} (no ip)",
    "format-disconnected": "󰤭  Offline",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "max-length": 30,
    "tooltip-format-wifi": "  {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}\nGW: {gwaddr}",
    "tooltip-format-ethernet": "󰈀  {ifname}\nIP: {ipaddr}/{cidr}\nGW: {gwaddr}",
    "tooltip-format-disconnected": "Network disconnected",
    "on-click": "/home/nick/.local/bin/matugen-rofi-pick.sh",
    "on-click-right": "nm-connection-editor",
    "on-click-middle": "nmcli device wifi rescan"
  },

  "custom/weather": {
    "format": " {}° ",
    "tooltip": true,
    "interval": 3600,
    "exec": "wttrbar --location Rochester_Hills --fahrenheit --main-indicator FeelsLikeF",
    "return-type": "json",
    "on-click": "kitty --title weather -e sh -lc 'curl -s wttr.in/Rochester_Hills?0; echo; echo Press any key to close...; read -n 1'",
    "on-click-right": "pkill -SIGRTMIN+8 waybar || pkill -RTMIN+8 waybar",
    "on-click-middle": "xdg-open 'https://wttr.in/Rochester_Hills'"
  },

  "custom/mpd": {
    "format": "󰰏 (MPD{icon})",
    "return-type": "json",
    "interval": 2,
    "exec": "~/.config/waybar/scripts/mpd-status.sh",
    "on-click": "~/.config/waybar/scripts/mpd-toggle.sh",
    "on-click-right": "mpc -q toggle",
    "on-scroll-up": "mpc -q next",
    "on-scroll-down": "mpc -q prev",
    "tooltip": true
  },

  "cpu": {
    "format": "󰐟 {usage}%",
    "interval": 2,
    "tooltip": true
  },

  "custom/pacman": {
    "format": "🡇  {}",
    "interval": 900,
    "exec": "bash -lc 'checkupdates 2>/dev/null | wc -l || echo 0'",
    "on-click": "kitty -e bash -lc 'yay && read'",
    "tooltip-format": "{} updates available"
  },

  "clock": {
    "format": " {:%R %d.%m} ",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
      "on-click": "shift_up"
    }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}