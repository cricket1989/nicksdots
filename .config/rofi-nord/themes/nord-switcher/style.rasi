/**
 * Nord Waybar Theme Switcher
 * nick@cachyos — compact list picker
 */

@import "../nord-grid/colors.rasi"

* {
    font:               "JetBrainsMono Nerd Font 10";
    background-color:   transparent;
    text-color:         @nord4;
    border:             0px;
    margin:             0px;
    padding:            0px;
    spacing:            0px;
}

configuration {
    modi:               "dmenu";
    show-icons:         false;
    hide-scrollbar:     true;
    font:               "JetBrainsMono Nerd Font 10";
}

window {
    background-color:   @nord0;
    border:             2px solid;
    border-color:       @nord10;
    border-radius:      14px;
    width:              480px;
    location:           center;
    transparency:       "real";
}

mainbox {
    background-color:   transparent;
    padding:            16px;
    spacing:            12px;
    children:           [inputbar, listview];
}

inputbar {
    background-color:   @nord1;
    border-radius:      10px;
    padding:            10px 14px;
    spacing:            8px;
    border:             1px solid;
    border-color:       @nord9t;
    children:           [icon-search, entry];
}

icon-search {
    expand:             false;
    filename:           "search";
    size:               16px;
    vertical-align:     0.5;
    background-color:   transparent;
    text-color:         @nord8;
}

entry {
    background-color:   transparent;
    text-color:         @nord4;
    placeholder:        "Switch waybar theme…";
    placeholder-color:  @nord3;
    cursor:             text;
    vertical-align:     0.5;
}

listview {
    background-color:   transparent;
    spacing:            4px;
    columns:            1;
    lines:              12;
    fixed-height:       false;
    scrollbar:          false;
    cycle:              true;
}

element {
    background-color:   transparent;
    border-radius:      8px;
    padding:            10px 14px;
    orientation:        horizontal;
    cursor:             pointer;
    spacing:            10px;
}

element normal.normal {
    background-color:   transparent;
    text-color:         @nord4;
}

element selected.normal {
    background-color:   @nord10;
    text-color:         @nord6;
}

element alternate.normal {
    background-color:   @nord0t;
    text-color:         @nord4;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    vertical-align:     0.5;
    horizontal-align:   0.0;
    font:               "JetBrainsMono Nerd Font 10";
}
