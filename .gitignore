# Caches
.cache/
*.log
*.db
history

# Secrets
.secrets
secrets

# Wallpapers (too large for git)
.config/hypr/modules/walls/
.config/wal/

# Browser/app data (not config)
.config/chromium/
.config/mozilla/
.config/discord/
.config/vesktop/
.config/Code/
.config/Claude/
.config/spotify/

# Crash backups
.config/chromium-backup-crashrecovery*/
.config/mozilla/firefox/*backup*

# oh-my-zsh (managed separately)
.oh-my-zsh/

# Old/unused
.config/alacritty/

# MPD runtime files
.config/mpd/database
.config/mpd/state
.config/mpd/pid
.config/mpd/log
.config/mpd/sticker.sql
.config/mpd/playlists/

# Compiled binaries in local/bin (add your actual script names to keep)
.local/bin/nitch
.local/bin/nitch1
.local/bin/uv
.local/bin/uvx
.local/bin/eww
.local/bin/webi
.local/bin/__pycache__/

# DankMaterialShell — plugins are managed by the shell, not hand-crafted
.config/DankMaterialShell/plugins/

# Runtime / app data (not hand-crafted config)
.config/go/
.config/heroic/
.config/libreoffice/
.config/pulse/
.config/psd/
.config/pypoetry/
.config/session/
.config/unity3d/
.config/uv/
.config/zoom.conf
.config/zoomus.conf

# KDE runtime state (not hand-crafted config)
.config/kactivitymanagerdrc
.config/kconf_updaterc
.config/kdeglobals
.config/kiorc
.config/konsole.kmessagebox
.config/konsolerc
.config/konsolesshconfig
.config/kservicemenurc
.config/ktrashrc
.config/plasma-localerc
.config/plasmarc
.config/trashrc
.config/baloofileinformationrc
.config/baloofilerc
.config/filetypesrc

# Backup/junk
*.bak
*.backup*
*.save
hyprland.conf.backup*
